generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

// ===========================
// ENUMS
// ===========================

enum VendorCategory {
    CREDIT
    DEBIT
}

enum PaymentType {
    CASH
    CREDIT
    BANK_TRANSFER
    PARTIAL
}

enum SaleStatus {
    PENDING
    COMPLETED
    CANCELLED
    REFUNDED
}

enum RefundStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
}

enum CustomerType {
    WALK_IN
    CORPORATE
    TABBY_OR_TAMARA
}

enum AccountType {
    CUSTOMER
    VENDOR
    CASH
    BANK
    EXPENSE
    INCOME
}

enum LedgerEntryType {
    OPENING_BALANCE
    SALE
    PAYMENT
    REFUND
    EXPENSE
    ADJUSTMENT
}

enum PaymentStatus {
    DUE
    PARTIAL
    PAID
}

enum PartyType {
    VENDOR
    CUSTOMER
}

enum ExpenseCategory {
    OFFICE_SUPPLIES
    SALARY
    TRAVEL
    MARKETING
    MEALS
    TRAINING
}

enum ExpenseStatus {
    APPROVED
    REJECTED
}

// ===========================
// AUTH / RBAC
// ===========================

model Permission {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    name        String   @unique
    description String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    roleLinks RolePermission[]
}

model Role {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    name        String   @unique
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    users           User[]
    permissionLinks RolePermission[]
}

model RolePermission {
    id           String @id @default(auto()) @map("_id") @db.ObjectId
    roleId       String @db.ObjectId
    permissionId String @db.ObjectId

    role       Role       @relation(fields: [roleId], references: [id])
    permission Permission @relation(fields: [permissionId], references: [id])

    @@unique([roleId, permissionId])
}

// ===========================
// BRANCHES & USERS
// ===========================

model Branch {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    name      String
    code      String    @unique
    address   String?
    city      String?
    country   String?
    phone     String?
    email     String?
    isActive  Boolean   @default(true)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    expenses  Expense[]
    users     User[]
}

model User {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    fullName  String
    email     String   @unique
    password  String
    phone     String?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    roleId   String? @db.ObjectId
    branchId String? @db.ObjectId

    role   Role?   @relation(fields: [roleId], references: [id])
    branch Branch? @relation(fields: [branchId], references: [id])

    salesInvoices SalesInvoice[]
    refunds       Refund[]
    expenses      Expense[]
}

// ===========================
// AIRLINES
// ===========================

model AirlineCode {
    id                String   @id @default(auto()) @map("_id") @db.ObjectId
    airlineName       String
    iataName          String?  @unique
    airlineCode       String?  @unique
    icao_code         String?
    country_territory String?
    status            Boolean  @default(true)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    sales Sale[]
}

// ===========================
// ACCOUNTS (CORE LEDGER)
// ===========================

model Account {
    id          String      @id @default(auto()) @map("_id") @db.ObjectId
    name        String
    type        AccountType
    referenceId String?     @db.ObjectId
    balance     Float       @default(0)
    isActive    Boolean     @default(true)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt

    entries   LedgerEntry[]
    vendors   Vendor[]
    customers Customer[]
    banks     Bank[]

    sales                  Sale[]
    salePayments           SalePayment[]
    vendorCustomerPayments VendorCustomerPayment[]
    expenses               Expense[]

    @@index([type])
    @@index([referenceId])
}

// ===========================
// LEDGER ENTRIES
// ===========================

model LedgerEntry {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    accountId String?  @db.ObjectId
    account   Account? @relation(fields: [accountId], references: [id])

    entryType LedgerEntryType

    debit  Float @default(0)
    credit Float @default(0)

    // References — only ONE should be populated per entry
    saleId                  String?  @db.ObjectId
    invoiceId               String?  @db.ObjectId
    paymentId               String?  @db.ObjectId // links to SalePayment.id for partial legs
    expenseId               String?  @db.ObjectId
    expense                 Expense? @relation(fields: [expenseId], references: [id])
    refundId                String?  @db.ObjectId
    vendorCustomerPaymentId String?  @db.ObjectId // links to VendorCustomerPayment.id

    vendorCustomerPayment VendorCustomerPayment? @relation(fields: [vendorCustomerPaymentId], references: [id])

    remarks String?

    // Business / accounting date (user-controlled)
    transactionDate DateTime

    // System date (auto, immutable)
    createdAt DateTime @default(now())

    @@index([accountId])
    @@index([entryType])
    @@index([saleId])
    @@index([paymentId])
    @@index([refundId])
    @@index([vendorCustomerPaymentId])
    @@index([expenseId])
    @@index([transactionDate])
    @@index([createdAt])
}

// ===========================
// VENDORS
// ===========================

model Vendor {
    id             String         @id @default(auto()) @map("_id") @db.ObjectId
    vendorName     String
    category       VendorCategory
    vendorType     String?
    email          String?
    phone          String?
    address        String?
    accountId      String         @db.ObjectId
    account        Account        @relation(fields: [accountId], references: [id])
    openingBalance Float?
    status         Boolean        @default(true)
    vendorDate     DateTime
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt

    sales    Sale[]
    payments VendorCustomerPayment[]

    @@index([vendorDate])
    @@index([createdAt])
}

// ===========================
// CUSTOMERS
// ===========================

model Customer {
    id             String       @id @default(auto()) @map("_id") @db.ObjectId
    customerName   String
    customerType   CustomerType
    customerVatId  String?
    contactPerson  String
    phone          String
    email          String?
    address        String?
    openingBalance Float        @default(0.00)
    accountId      String       @db.ObjectId
    account        Account      @relation(fields: [accountId], references: [id])
    isActive       Boolean      @default(true)
    customerDate   DateTime
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt

    sales        Sale[]
    salePayments SalePayment[]
    payments     VendorCustomerPayment[]

    @@index([customerName])
    @@index([phone])
    @@index([customerDate])
    @@index([createdAt])
}

// ===========================
// BANKS
// ===========================

model Bank {
    id             String   @id @default(auto()) @map("_id") @db.ObjectId
    bankName       String
    accountNumber  String   @unique
    branchName     String?
    swiftCode      String?
    openingBalance Float    @default(0)
    accountId      String   @db.ObjectId
    account        Account  @relation(fields: [accountId], references: [id])
    isActive       Boolean  @default(true)
    bankDate       DateTime
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    sales                  Sale[]
    salePayments           SalePayment[]
    vendorCustomerPayments VendorCustomerPayment[]
    expenses               Expense[]

    @@index([bankDate])
    @@index([createdAt])
}

// ===========================
// SALES & INVOICES
// ===========================

model InvoiceCounter {
    id            String   @id @default(auto()) @map("_id") @db.ObjectId
    key           String   @unique
    currentNumber Int      @default(0)
    updatedAt     DateTime @updatedAt
}

model SalesInvoice {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    invoiceNo   String   @unique
    saleDate    DateTime @default(now())
    userId      String   @db.ObjectId
    user        User     @relation(fields: [userId], references: [id])
    totalNet    Float    @default(0)
    totalSell   Float    @default(0)
    totalProfit Float    @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    sales Sale[]

    @@index([saleDate])
    @@index([createdAt])
}

// ===========================
// SALE
// ===========================

model Sale {
    id         String  @id @default(auto()) @map("_id") @db.ObjectId
    invoiceId  String  @db.ObjectId
    airlineId  String  @db.ObjectId
    vendorId   String  @db.ObjectId
    customerId String? @db.ObjectId

    // Flight details
    pnr           String?
    documentNo    String?
    routeType     String?
    tripType      String?   @default("Oneway")
    departureDate DateTime?
    returnDate    DateTime?

    // Bank — populated when paymentType is BANK_TRANSFER (single payment)
    // For PARTIAL payments the legs live in SalePayment; leave this null
    bankId String? @db.ObjectId
    bank   Bank?   @relation(fields: [bankId], references: [id])

    // Pricing & taxes
    netPrice    Float
    sellPrice   Float
    profit      Float
    paxVat      Float? @default(0)
    vatAmount   Float? @default(0)
    miscCharges Float? @default(0)

    // Payment & status
    paymentType   PaymentType
    paymentStatus PaymentStatus @default(DUE)
    paidAmount    Float         @default(0)

    remarks      String?
    status       SaleStatus @default(PENDING)
    paxName      String?
    destinations Json?

    // Relations
    invoice  SalesInvoice @relation(fields: [invoiceId], references: [id])
    airline  AirlineCode  @relation(fields: [airlineId], references: [id])
    vendor   Vendor       @relation(fields: [vendorId], references: [id])
    customer Customer?    @relation(fields: [customerId], references: [id])

    refunds  Refund[]
    payments SalePayment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    account   Account? @relation(fields: [accountId], references: [id])
    accountId String?  @db.ObjectId

    @@index([pnr])
    @@index([status])
    @@index([createdAt])
    @@index([accountId])
}

// ===========================
// SALE PAYMENT
// One row per payment leg.
// Single payments → 1 row.
// Partial/split    → 2 rows (one per method).
// ===========================

model SalePayment {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    saleId String @db.ObjectId
    sale   Sale   @relation(fields: [saleId], references: [id])

    method PaymentType // CASH | BANK_TRANSFER | CREDIT (never PARTIAL here)
    amount Float

    // Populated only when method = BANK_TRANSFER
    bankId String? @db.ObjectId
    bank   Bank?   @relation(fields: [bankId], references: [id])

    // Populated only when method = CREDIT
    customerId String?   @db.ObjectId
    customer   Customer? @relation(fields: [customerId], references: [id])

    remarks     String?
    paymentDate DateTime
    createdAt   DateTime @default(now())
    account     Account? @relation(fields: [accountId], references: [id])
    accountId   String?  @db.ObjectId

    @@index([saleId])
    @@index([bankId])
    @@index([customerId])
    @@index([paymentDate])
    @@index([accountId])
}

// ===========================
// REFUND
// ===========================

model Refund {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    saleId String @db.ObjectId
    sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

    // Financials
    originalSaleAmount   Float
    customerRefundAmount Float
    vendorRefundAmount   Float?
    refundFee            Float  @default(0)
    cancellationCharges  Float  @default(0)
    netRefundToCustomer  Float
    netCostToUs          Float

    // Details
    refundReason String?
    remarks      String?
    status       RefundStatus @default(PENDING)

    // Dates
    refundDate  DateTime
    approvedAt  DateTime?
    completedAt DateTime?

    // Who processed
    processedById String? @db.ObjectId
    processedBy   User?   @relation(fields: [processedById], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([saleId])
    @@index([status])
    @@index([refundDate])
    @@index([createdAt])
}

// ===========================
// VENDOR / CUSTOMER PAYMENT
// One row per payment transaction (NOT per leg, unlike SalePayment).
// - method = CASH          -> only the vendor/customer account leg posts (1 LedgerEntry)
// - method = BANK_TRANSFER -> vendor/customer leg AND bank leg both post (2 LedgerEntry rows)
// Exactly one of vendorId / customerId must be populated (driven by partyType).
// ===========================

model VendorCustomerPayment {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    partyType PartyType // VENDOR | CUSTOMER — tells you which relation below is populated

    // Populated when partyType = VENDOR
    vendorId String? @db.ObjectId
    vendor   Vendor? @relation(fields: [vendorId], references: [id])

    // Populated when partyType = CUSTOMER
    customerId String?   @db.ObjectId
    customer   Customer? @relation(fields: [customerId], references: [id])

    method PaymentType // CASH | BANK_TRANSFER only (never CREDIT / PARTIAL here)
    amount Float

    // Populated only when method = BANK_TRANSFER
    bankId String? @db.ObjectId
    bank   Bank?   @relation(fields: [bankId], references: [id])

    // Cloudinary URL only — actual file lives on Cloudinary, not in Mongo
    attachmentUrl String?

    remarks String?

    // Business / accounting date — user-selected on the payment form
    transactionDate DateTime

    // System date — auto, immutable
    createdAt DateTime @default(now())

    // Resulting ledger rows (1 for CASH, 2 for BANK_TRANSFER) — handy for audits/reversals
    ledgerEntries LedgerEntry[]
    account       Account?      @relation(fields: [accountId], references: [id])
    accountId     String?       @db.ObjectId

    @@index([partyType])
    @@index([vendorId])
    @@index([customerId])
    @@index([bankId])
    @@index([transactionDate])
    @@index([createdAt])
    @@index([accountId])
}

// ===========================
// EXPENSE
// One row per expense transaction.
//
// - branchId is a PLAIN REFERENCE ONLY — it does NOT correspond to any Account
//   record. Per-branch totals are computed on demand (e.g. groupBy branchId
//   and sum amount), not tracked as a running balance.
// - paymentMode = CASH          -> nothing posts to any account/ledger at all.
//                                   The expense is just recorded.
// - paymentMode = BANK_TRANSFER -> the bank account is debited (balance
//                                   decreases) and exactly ONE LedgerEntry is
//                                   created against the bank's Account.
// - Only status = APPROVED expenses ever touch the bank balance / ledger.
// ===========================

model Expense {
    id String @id @default(auto()) @map("_id") @db.ObjectId

    // When the expense record itself was logged/created
    date DateTime @default(now())

    // Business/accounting date — this is what drives LedgerEntry.transactionDate
    expenseDate DateTime

    category ExpenseCategory

    // Plain reference for reporting/aggregation only — no Account is tied to this.
    branchId String @db.ObjectId
    branch   Branch @relation(fields: [branchId], references: [id])

    amount Float

    // Default APPROVED — REJECTED expenses are recorded but never post to the ledger
    status ExpenseStatus @default(APPROVED)

    // CASH | BANK_TRANSFER only
    paymentMode PaymentType

    // Populated only when paymentMode = BANK_TRANSFER — this is the ONLY
    // account ever affected by an expense.
    bankId String? @db.ObjectId
    bank   Bank?   @relation(fields: [bankId], references: [id])
    userId String? @db.ObjectId
    user   User?   @relation(fields: [userId], references: [id])

    description String?

    ledgerEntries LedgerEntry[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    account   Account? @relation(fields: [accountId], references: [id])
    accountId String?  @db.ObjectId

    @@index([branchId])
    @@index([category])
    @@index([status])
    @@index([paymentMode])
    @@index([bankId])
    @@index([expenseDate])
    @@index([createdAt])
    @@index([accountId])
}
