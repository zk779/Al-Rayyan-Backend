generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "mongodb"
	url = env("DATABASE_URL")
}

/**
	* ===========================
	* ENUMS
	* ===========================
	*/

enum VendorCategory {
	CREDIT
	DEBIT
}

enum PaymentType {
	CASH
	CREDIT
	BANK_TRANSFER
}

enum SaleStatus {
	PENDING
	COMPLETED
	CANCELLED
	REFUNDED  // Sale that has been refunded
}

enum RefundStatus {
	PENDING
	APPROVED
	REJECTED
	COMPLETED
}

enum CustomerType {
	WALK_IN
	CORPORATE
}

enum AccountType {
	CUSTOMER
	VENDOR
	CASH
	BANK
	EXPENSE
	INCOME
}

enum LedgerEntryType {
	OPENING_BALANCE
	SALE
	PAYMENT
	REFUND
	EXPENSE
	ADJUSTMENT
}

enum PaymentStatus {
	DUE
	PARTIAL
	PAID
}

/**
	* ===========================
	* AUTH / RBAC
	* ===========================
	*/

model Permission {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	name String @unique
	description String?
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	roleLinks RolePermission[]
}

model Role {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	name String @unique
	description String?
	isActive Boolean @default(true)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	users User[]
	permissionLinks RolePermission[]
}

model RolePermission {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	roleId String @db.ObjectId
	permissionId String @db.ObjectId

	role Role @relation(fields: [roleId], references: [id])
	permission Permission @relation(fields: [permissionId], references: [id])

	@@unique([roleId, permissionId])
}

/**
	* ===========================
	* BRANCHES & USERS
	* ===========================
	*/

model Branch {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	name String
	code String @unique
	address String?
	city String?
	country String?
	phone String?
	email String?
	isActive Boolean @default(true)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	users User[]
}

model User {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	fullName String
	email String @unique
	password String
	phone String?
	isActive Boolean @default(true)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	roleId String? @db.ObjectId
	branchId String? @db.ObjectId

	role Role? @relation(fields: [roleId], references: [id])
	branch Branch? @relation(fields: [branchId], references: [id])
	
	salesInvoices SalesInvoice[]
	refunds Refund[]
}

/**
	* ===========================
	* AIRLINES
	* ===========================
	*/

model AirlineCode {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	airlineName String
	iataName String? @unique
	airlineCode String? @unique
	icao_code String?
	country_territory String?
	status Boolean @default(true)
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	sales Sale[]
}

/**
	* ===========================
	* ACCOUNTS (🔥 CORE LEDGER)
	* ===========================
	*/

model Account {
	id String @id @default(auto()) @map("_id") @db.ObjectId

	name String
	type AccountType

	referenceId String? @db.ObjectId // vendorId / customerId / bankId

	balance Float @default(0)

	isActive Boolean @default(true)

	entries LedgerEntry[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	vendors Vendor[]
	customers Customer[]

	@@index([type])
	@@index([referenceId])
}

/**
	* ===========================
	* LEDGER ENTRIES (🔥 SINGLE LEDGER)
	* ===========================
	*/

model LedgerEntry {
	id String @id @default(auto()) @map("_id") @db.ObjectId

	accountId String @db.ObjectId
	account Account @relation(fields: [accountId], references: [id])

	entryType LedgerEntryType

	debit Float @default(0)
	credit Float @default(0)

	// ❌ REMOVED: balanceAfter Float
	// Balance is now stored only on Account model and updated via transactions

	// 🔗 References - only ONE should be populated
	saleId String? @db.ObjectId
	invoiceId String? @db.ObjectId
	paymentId String? @db.ObjectId
	expenseId String? @db.ObjectId
	refundId String? @db.ObjectId

	remarks String?

	// 📅 BUSINESS / ACCOUNTING DATE (user-controlled)
	transactionDate DateTime

	// 🕒 SYSTEM DATE (auto, immutable)
	createdAt DateTime @default(now())

	@@index([accountId])
	@@index([entryType])
	@@index([saleId])
	@@index([refundId])
	@@index([transactionDate])
	@@index([createdAt])
}

/**
	* ===========================
	* VENDORS
	* ===========================
	*/

model Vendor {
	id String @id @default(auto()) @map("_id") @db.ObjectId

	vendorName String
	category VendorCategory // CREDIT or DEBIT

	vendorType String?
	email String?
	phone String?
	address String?

	accountId String @db.ObjectId
	account Account @relation(fields: [accountId], references: [id])

	openingBalance Float?
	status Boolean @default(true)

	vendorDate DateTime // user-selected business date
	createdAt DateTime @default(now()) // system timestamp
	updatedAt DateTime @updatedAt

	sales Sale[]

	@@index([vendorDate])
	@@index([createdAt])
}

/**
	* ===========================
	* CUSTOMERS
	* ===========================
	*/

model Customer {
	id String @id @default(auto()) @map("_id") @db.ObjectId

	// Core info
	customerName String
	customerType CustomerType
	customerVatId String?

	contactPerson String
	phone String

	// Optional info
	email String?
	address String?

	// Accounting
	openingBalance Float @default(0.00)

	accountId String @db.ObjectId
	account Account @relation(fields: [accountId], references: [id])

	// Status
	isActive Boolean @default(true)

	customerDate DateTime // user-selected business date
	createdAt DateTime @default(now()) // system timestamp
	updatedAt DateTime @updatedAt

	sales Sale[]

	@@index([customerName])
	@@index([phone])
	@@index([customerDate])
	@@index([createdAt])
}

/**
	* ===========================
	* SALES & INVOICES
	* ===========================
	*/
model InvoiceCounter {
	id String @id @default(auto()) @map("_id") @db.ObjectId
	key String @unique
	currentNumber Int @default(0)
	updatedAt DateTime @updatedAt
}

model SalesInvoice {
	id String @id @default(auto()) @map("_id") @db.ObjectId

	invoiceNo String @unique
	saleDate DateTime @default(now())

	userId String @db.ObjectId
	user User @relation(fields: [userId], references: [id])

	totalNet Float @default(0)
	totalSell Float @default(0)
	totalProfit Float @default(0)

	sales Sale[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([saleDate])
	@@index([createdAt])
}

/**
	* ===========================
	* SALE MODEL (CLEANED UP)
	* ===========================
	*/
model Sale {
	id String @id @default(auto()) @map("_id") @db.ObjectId

	invoiceId String @db.ObjectId
	airlineId String @db.ObjectId
	vendorId String @db.ObjectId
	customerId String? @db.ObjectId

	// 🎫 FLIGHT DETAILS
	pnr String?
	documentNo String?
	routeType String? // e.g., "Domestic" or "International"
	tripType String? @default("Oneway") // e.g., "Oneway" or "RoundTrip"
	departureDate DateTime?
	returnDate DateTime?

	// 💰 PRICING & TAXES
	netPrice Float
	sellPrice Float
	profit Float
	paxVat Float? @default(0)
	vatAmount Float? @default(0)
	miscCharges Float? @default(0)

	// 💳 PAYMENT & STATUS
	paymentType PaymentType
	paymentStatus PaymentStatus @default(DUE)
	paidAmount Float @default(0)

	remarks String?
	status SaleStatus @default(PENDING)
	paxName String?
	destinations Json?

	// 🔗 RELATIONS
	invoice SalesInvoice @relation(fields: [invoiceId], references: [id])
	airline AirlineCode @relation(fields: [airlineId], references: [id])
	vendor Vendor @relation(fields: [vendorId], references: [id])
	customer Customer? @relation(fields: [customerId], references: [id])
	
	// 🔙 REVERSE RELATION: Refunds made against this sale
	refunds Refund[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([pnr])
	@@index([status])
	@@index([createdAt])
}

/**
	* ===========================
	* REFUND MODEL (SEPARATED)
	* ===========================
	*/
model Refund {
	id String @id @default(auto()) @map("_id") @db.ObjectId

	// 🔗 ORIGINAL SALE REFERENCE
	saleId String @db.ObjectId
	sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

	// 💰 REFUND FINANCIALS
	originalSaleAmount Float // Original sale price
	customerRefundAmount Float // Amount to refund to customer
	vendorRefundAmount Float? // Amount vendor will refund to us
	
	refundFee Float @default(0) // Our service charge for processing refund
	cancellationCharges Float @default(0) // Airline/vendor cancellation fee
	
	netRefundToCustomer Float // Final amount customer receives
	netCostToUs Float // Our net loss/gain on this refund

	// 📋 REFUND DETAILS
	refundReason String?
	remarks String?
	
	status RefundStatus @default(PENDING)
	
	// 📅 DATES
	refundDate DateTime // Business date of refund
	approvedAt DateTime? // When refund was approved
	completedAt DateTime? // When refund payment was made
	
	// 👤 WHO PROCESSED
	processedById String? @db.ObjectId
	processedBy User? @relation(fields: [processedById], references: [id])
	
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([saleId])
	@@index([status])
	@@index([refundDate])
	@@index([createdAt])
}
